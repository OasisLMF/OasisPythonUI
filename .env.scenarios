# ============================================================================
# PUBLIC SCENARIOS DEMO CONFIGURATION
# ============================================================================
# Credential-free Scenarios app (scenarios_app.py): visitors run pre-loaded
# scenarios against pre-loaded exposure and view the results. No uploads, no
# public API. Deploy with:
#
#   cp .env.scenarios .env      # then change every CHANGE_ME value below
#   ./install.sh
#
# The demo uses simple auth with a service account that only the UI and its
# setup/prune services use; visitors never log in.
# ============================================================================

# Public demo: Scenarios app only, no public API/database ports (docker-compose.public.yml)
OASIS_PUBLIC_DEMO=true
MODEL_SET=scenarios
# Directory holding the scenario model data (cloned by get-scenarios.sh if missing)
SCENARIOS_PATH=/home/ubuntu/Scenarios
# Bundled analysis settings used when the platform has no settings template
UI_DEFAULTS=./scenarios/defaults
# Days to keep visitors' runs (showcase runs are always kept)
OASIS_PRUNE_DAYS=7
# Per scenario worker: tasks at a time and memory cap (13 workers share the host)
OASIS_WORKER_CONCURRENCY=1
OASIS_WORKER_MEM_LIMIT=6g
# Set to get a Let's Encrypt certificate for OASIS_UI_HOSTNAME (must be public)
OASIS_ACME_EMAIL=

# Project Configuration
COMPOSE_PROJECT_NAME=oasisscenarios
OASIS_DEBUG=0

# Docker socket path (Docker Desktop uses ~/.docker/desktop/docker.sock)
# Standard Docker: /var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# Hostname Configuration
OASIS_UI_HOSTNAME=oasislmf-scenarios.com
OASIS_PROTOCOL=https

# Authentication Type
API_AUTH_TYPE=simple
OASIS_SERVER_ALLOWED_OIDC_AUTH_PROVIDERS=keycloak,authentik

# Simple Auth Credentials
OASIS_ADMIN_USER=admin
OASIS_ADMIN_PASS=CHANGE_ME

# Image Versions
SERVER_IMG=coreoasis/api_server
VERS_API=2.5.9
WORKER_IMG=coreoasis/model_worker
VERS_WORKER=2.5.9
PYTHONUI_IMG=coreoasis/oasispythonui_app
VERS_UI=latest
VERS_PIWIND=2.5.9

# Database Configuration
OASIS_SERVER_DB_HOST=server-db
OASIS_SERVER_DB_PORT=5432
OASIS_SERVER_DB_NAME=oasis
OASIS_SERVER_DB_USER=oasis
OASIS_SERVER_DB_PASS=CHANGE_ME

OASIS_CELERY_DB_HOST=celery-db
OASIS_CELERY_DB_PORT=5432
OASIS_CELERY_DB_NAME=celery
OASIS_CELERY_DB_USER=celery
OASIS_CELERY_DB_PASS=CHANGE_ME

# Broker & Channel Layer
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=CHANGE_ME
OASIS_CELERY_BROKER_URL=amqp://rabbit:CHANGE_ME@broker:5672
REDIS_HOST=channel-layer
REDIS_PORT=6379
OASIS_SERVER_CHANNEL_LAYER_SSL=false

# Advanced Configuration
OASIS_PORTFOLIO_UPLOAD_VALIDATION=0
OASIS_OASISLMF_VERSION=
OASIS_ODS_VERSION=
OASIS_ODM_VERSION=
OASIS_OED_SCHEMA_INFO=
